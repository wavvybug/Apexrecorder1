            "CodeContent": "package com.apexrec.app.processing\n\nimport android.media.MediaCodec\nimport android.media.MediaExtractor\nimport android.media.MediaFormat\nimport android.media.MediaMuxer\nimport android.util.Log\nimport kotlinx.coroutines.Dispatchers\nimport kotlinx.coroutines.withContext\nimport java.io.File\nimport java.nio.ByteBuffer\n\n/**\n * Lossless Video Trimming Engine using native Android MediaExtractor and MediaMuxer.\n * Cuts video at keyframes in milliseconds without re-encoding or generational quality loss.\n */\nobject LosslessTrimmer {\n\n    private const val TAG \u003d \"LosslessTrimmer\"\n    private const val DEFAULT_BUFFER_SIZE \u003d 2 * 1024 * 1024 // 2MB chunk buffer\n\n    sealed class TrimResult {\n        data class Success(val outputPath: String, val durationMs: Long, val fileSizeBytes: Long) : TrimResult()\n        data class Error(val message: String, val throwable: Throwable? \u003d null) : TrimResult()\n    }\n\n    suspend fun trim(\n        sourcePath: String,\n        outputPath: String,\n        startMs: Long,\n        endMs: Long,\n        onProgress: (Float) -\u003e Unit \u003d {}\n    ): TrimResult \u003d withContext(Dispatchers.IO) {\n        val sourceFile \u003d File(sourcePath)\n        if (!sourceFile.exists()) {\n            return@withContext TrimResult.Error(\"Source file does not exist: $sourcePath\")\n        }\n\n        val startUs \u003d startMs * 1000L\n        val endUs \u003d endMs * 1000L\n        val totalSpanUs \u003d endUs - startUs\n\n        if (totalSpanUs \u003c\u003d 0) {\n            return@withContext TrimResult.Error(\"Invalid trim range: start ($startMs ms) must be less than end ($endMs ms)\")\n        }\n\n        var extractor: MediaExtractor? \u003d null\n        var muxer: MediaMuxer? \u003d null\n\n        try {\n            extractor \u003d MediaExtractor()\n            extractor.setDataSource(sourcePath)\n\n            val trackCount \u003d extractor.trackCount\n            val outputFile \u003d File(outputPath)\n            outputFile.parentFile?.mkdirs()\n            if (outputFile.exists()) {\n                outputFile.delete()\n            }\n\n            muxer \u003d MediaMuxer(outputPath, MediaMuxer.OutputFormat.MUXER_OUTPUT_MPEG_4)\n\n            // Track index mapping: extractorTrackIndex -\u003e muxerTrackIndex\n            val indexMap \u003d HashMap\u003cInt, Int\u003e()\n            var videoTrackIndex \u003d -1\n            var audioTrackIndex \u003d -1\n            var maxBufferSize \u003d DEFAULT_BUFFER_SIZE\n\n            for (i in 0 until trackCount) {\n                val format \u003d extractor.getTrackFormat(i)\n                val mime \u003d format.getString(MediaFormat.KEY_MIME) ?: \"\"\n\n                if (format.containsKey(MediaFormat.KEY_MAX_INPUT_SIZE)) {\n                    val bufferSize \u003d format.getInteger(MediaFormat.KEY_MAX_INPUT_SIZE)\n                    if (bufferSize \u003e maxBufferSize) {\n                        maxBufferSize \u003d bufferSize\n                    }\n                }\n\n                if (mime.startsWith(\"video/\")) {\n                    videoTrackIndex \u003d i\n                    val muxerIndex \u003d muxer.addTrack(format)\n                    indexMap[i] \u003d muxerIndex\n                } else if (mime.startsWith(\"audio/\")) {\n                    audioTrackIndex \u003d i\n                    val muxerIndex \u003d muxer.addTrack(format)\n                    indexMap[i] \u003d muxerIndex\n                }\n            }\n\n            if (videoTrackIndex \u003d\u003d -1) {\n                return@withContext TrimResult.Error(\"No video track found in source\")\n            }\n\n            muxer.start()\n\n            val buffer \u003d ByteBuffer.allocate(maxBufferSize)\n            val bufferInfo \u003d MediaCodec.BufferInfo()\n\n            // Process video track first (aligned to closest prior keyframe)\n            extractor.selectTrack(videoTrackIndex)\n            extractor.seekTo(startUs, MediaExtractor.SEEK_TO_PREVIOUS_SYNC)\n\n            // Determine video start offset\n            val videoFirstSampleUs \u003d extractor.sampleTime\n            var lastVideoSampleTimeUs \u003d 0L\n\n            while (true) {\n                bufferInfo.size \u003d extractor.readSampleData(buffer, 0)\n                if (bufferInfo.size \u003c 0) {\n                    break\n                }\n\n                val presentationTimeUs \u003d extractor.sampleTime\n                if (presentationTimeUs \u003e endUs) {\n                    break\n                }\n\n                bufferInfo.presentationTimeUs \u003d kotlin.math.max(0L, presentationTimeUs - videoFirstSampleUs)\n                bufferInfo.offset \u003d 0\n                bufferInfo.flags \u003d extractor.sampleFlags\n\n                val muxerTrack \u003d indexMap[videoTrackIndex] ?: 0\n                muxer.writeSampleData(muxerTrack, buffer, bufferInfo)\n                lastVideoSampleTimeUs \u003d presentationTimeUs\n\n                if (totalSpanUs \u003e 0) {\n                    val progress \u003d ((presentationTimeUs - startUs).toFloat() / totalSpanUs.toFloat())\n                        .coerceIn(0f, 0.5f)\n                    onProgress(progress)\n                }\n\n                extractor.advance()\n            }\n            extractor.unselectTrack(videoTrackIndex)\n\n            // Process audio track if present\n            if (audioTrackIndex !\u003d -1) {\n                extractor.selectTrack(audioTrackIndex)\n                extractor.seekTo(startUs, MediaExtractor.SEEK_TO_CLOSEST_SYNC)\n\n                val audioFirstSampleUs \u003d extractor.sampleTime\n\n                while (true) {\n                    bufferInfo.size \u003d extractor.readSampleData(buffer, 0)\n                    if (bufferInfo.size \u003c 0) {\n                        break\n                    }\n\n                    val presentationTimeUs \u003d extractor.sampleTime\n                    if (presentationTimeUs \u003e endUs) {\n                        break\n                    }\n\n                    bufferInfo.presentationTimeUs \u003d kotlin.math.max(0L, presentationTimeUs - audioFirstSampleUs)\n                    bufferInfo.offset \u003d 0\n                    bufferInfo.flags \u003d extractor.sampleFlags\n\n                    val muxerTrack \u003d indexMap[audioTrackIndex] ?: 0\n                    muxer.writeSampleData(muxerTrack, buffer, bufferInfo)\n\n                    if (totalSpanUs \u003e 0) {\n                        val progress \u003d 0.5f + ((presentationTimeUs - startUs).toFloat() / totalSpanUs.toFloat() * 0.5f)\n                            .coerceIn(0f, 0.5f)\n                        onProgress(progress)\n                    }\n\n                    extractor.advance()\n                }\n                extractor.unselectTrack(audioTrackIndex)\n            }\n\n            onProgress(1.0f)\n            Log.i(TAG, \"Lossless trim completed successfully: $outputPath\")\n\n            val outputFileSize \u003d File(outputPath).length()\n            val actualDurationMs \u003d kotlin.math.max(100L, endMs - startMs)\n\n            TrimResult.Success(\n                outputPath \u003d outputPath,\n                durationMs \u003d actualDurationMs,\n                fileSizeBytes \u003d outputFileSize\n            )\n        } catch (e: Exception) {\n            Log.e(TAG, \"Lossless trim failed\", e)\n            TrimResult.Error(\"Trimming failed: ${e.localizedMessage ?: \"Unknown error\"}\", e)\n        } finally {\n            try {\n                muxer?.stop()\n                muxer?.release()\n            } catch (e: Exception) {\n                Log.w(TAG, \"Error releasing muxer\", e)\n            }\n            try {\n                extractor?.release()\n            } catch (e: Exception) {\n                Log.w(TAG, \"Error releasing extractor\", e)\n            }\n        }\n    }\n}\n",
