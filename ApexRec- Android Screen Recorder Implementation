port com.apexrec.app.ui.theme.TextMuted\nimport com.apexrec.app.ui.theme.TextPrimary\nimport com.apexrec.app.ui.theme.TextSecondary\nimport com.apexrec.app.ui.theme.VoidBlack\nimport com.apexrec.app.ui.viewmodel.ApexRecViewModel\nimport kotlinx.coroutines.delay\nimport kotlinx.coroutines.isActive\nimport java.io.File\nimport java.util.Locale\n\n@OptIn(UnstableApi::class)\n@Composable\nfun VideoPlayerAndTrimmerScreen(\n    recording: RecordingEntity,\n    viewModel: ApexRecViewModel,\n    onBack: () -\u003e Unit,\n    modifier: Modifier \u003d Modifier\n) {\n    val context \u003d LocalContext.current\n    val trimProgress by viewModel.trimProgress.collectAsState()\n\n    var isPlaying by remember { mutableStateOf(false) }\n    var currentPositionMs by remember { mutableLongStateOf(0L) }\n    var totalDurationMs by remember { mutableLongStateOf(recording.durationMs.coerceAtLeast(1000L)) }\n    var playbackSpeed by remember { mutableFloatStateOf(1.0f) }\n\n    // Trimmer start \u0026 end sliders (in milliseconds)\n    var trimRange by remember { mutableStateOf(0f..totalDurationMs.toFloat()) }\n\n    // ExoPlayer initialization\n    val exoPlayer \u003d remember {\n        ExoPlayer.Builder(context).build().apply {\n            val file \u003d File(recording.filePath)\n            if (file.exists()) {\n                val mediaItem \u003d MediaItem.fromUri(Uri.fromFile(file))\n                setMediaItem(mediaItem)\n                prepare()\n            }\n        }\n    }\n\n    DisposableEffect(recording.filePath) {\n        val listener \u003d object : Player.Listener {\n            override fun onIsPlayingChanged(playing: Boolean) {\n                isPlaying \u003d playing\n            }\n\n            override fun onPlaybackStateChanged(playbackState: Int) {\n                if (playbackState \u003d\u003d Player.STATE_READY) {\n                    val dur \u003d exoPlayer.duration\n                    if (dur \u003e 0) {\n                        totalDurationMs \u003d dur\n                        trimRange \u003d 0f..dur.toFloat()\n                    }\n                }\n            }\n        }\n        exoPlayer.addListener(listener)\n\n        onDispose {\n            exoPlayer.removeListener(listener)\n            exoPlayer.release()\n        }\n    }\n\n    // Position polling loop\n    LaunchedEffect(isPlaying) {\n        while (isActive \u0026\u0026 isPlaying) {\n            currentPositionMs \u003d exoPlayer.currentPosition\n            delay(150)\n        }\n    }\n\n    Box(\n        modifier \u003d modifier\n            .fillMaxSize()\n            .background(SlateBackground)\n    ) {\n        Column(\n            modifier \u003d Modifier\n                .fillMaxSize()\n                .verticalScroll(rememberScrollState())\n                .padding(horizontal \u003d 16.dp, vertical \u003d 16.dp),\n            verticalArrangement \u003d Arrangement.spacedBy(14.dp)\n        ) {\n            // Header Bar\n            Row(\n                modifier \u003d Modifier.fillMaxWidth(),\n                horizontalArrangement \u003d Arrangement.SpaceBetween,\n                verticalAlignment \u003d Alignment.CenterVertically\n            ) {\n                Row(verticalAlignment \u003d Alignment.CenterVertically) {\n                    IconButton(onClick \u003d onBack) {\n                        Icon(\n                            imageVector \u003d Icons.Default.ArrowBack,\n                            contentDescription \u003d \"Back\",\n                            tint \u003d ElectricCyan\n                        )\n                    }\n                    Spacer(modifier \u003d Modifier.width(6.dp))\n                    Text(\n                        text \u003d \"STUDIO PLAYER\",\n                        color \u003d ElectricCyan,\n                        fontSize \u003d 18.sp,\n                        fontWeight \u003d FontWeight.Black,\n                        fontFamily \u003d FontFamily.Monospace,\n                        letterSpacing \u003d 1.sp\n                    )\n                }\n\n                IconButton(onClick \u003d { viewModel.shareRecording(context, recording) }) {\n                    Icon(\n                        imageVector \u003d Icons.Default.Share,\n                        contentDescription \u003d \"Share\",\n                        tint \u003d TextSecondary\n                    )\n                }\n            }\n\n            // Video Player Container\n            Box(\n                modifier \u003d Modifier\n                    .fillMaxWidth()\n                    .aspectRatio(16f / 9f)\n                    .clip(RoundedCornerShape(12.dp))\n                    .background(VoidBlack)\n                    .border(1.dp, SlateBorder, RoundedCornerShape(12.dp)),\n                contentAlignment \u003d Alignment.Center\n            ) {\n                AndroidView(\n                    factory \u003d {\n                        PlayerView(it).apply {\n                            player \u003d exoPlayer\n                            useController \u003d false\n                        }\n                    },\n                    modifier \u003d Modifier.fillMaxSize()\n                )\n            }\n\n            // Playback Transport Controls\n            CyberCard {\n                Column(verticalArrangement \u003d Arrangement.spacedBy(10.dp)) {\n                    // Position Bar Slider\n                    Slider(\n                        value \u003d currentPositionMs.toFloat().coerceIn(0f, totalDurationMs.toFloat()),\n                        onValueChange \u003d { newPos -\u003e\n                            currentPositionMs \u003d newPos.toLong()\n                            exoPlayer.seekTo(currentPositionMs)\n                        },\n                        valueRange \u003d 0f..totalDurationMs.toFloat(),\n                        colors \u003d SliderDefaults.colors(\n                            thumbColor \u003d ElectricCyan,\n                            activeTrackColor \u003d ElectricCyan,\n                            inactiveTrackColor \u003d SlateSurfaceElevated\n                        )\n                    )\n\n                    // Digital Readout\n                    Row(\n                        modifier \u003d Modifier.fillMaxWidth(),\n                        horizontalArrangement \u003d Arrangement.SpaceBetween\n                    ) {\n                        Text(\n                            text \u003d formatTimeMs(currentPositionMs),\n                            style \u003d DigitalTelemetryStyle\n                        )\n                        Text(\n                            text \u003d formatTimeMs(totalDurationMs),\n                            style \u003d DigitalTelemetryStyle,\n                            color \u003d TextMuted\n                        )\n                    }\n\n                    // Main Controls: Replay, Play/Pause, Fast-forward\n                    Row(\n                        modifier \u003d Modifier.fillMaxWidth(),\n                        horizontalArrangement \u003d Arrangement.Center,\n                        verticalAlignment \u003d Alignment.CenterVertically\n                    ) {\n                        IconButton(\n                            onClick \u003d {\n                                val target \u003d (exoPlayer.currentPosition - 10_000L).coerceAtLeast(0L)\n                                exoPlayer.seekTo(target)\n                            }\n                        ) {\n                            Icon(\n                                imageVector \u003d Icons.Default.Replay10,\n                                contentDescription \u003d \"Rewind 10s\",\n                                tint \u003d TextSecondary\n                            )\n                        }\n\n                        Spacer(modifier \u003d Modifier.width(16.dp))\n\n                        // Play/Pause button\n                        Box(\n                            modifier \u003d Modifier\n                                .size(54.dp)\n                                .clip(CircleShape)\n                                .background(ElectricCyan)\n                                .border(2.dp, Color.White.copy(alpha \u003d 0.4f), CircleShape),\n                            contentAlignment \u003d Alignment.Center\n                        ) {\n                            IconButton(\n                                onClick \u003d {\n                                    if (isPlaying) {\n                                        exoPlayer.pause()\n                                    } else {\n                                        exoPlayer.play()\n                                    }\n                                }\n                            ) {\n                                Icon(\n                                    imageVector \u003d if (isPlaying) Icons.Default.Pause else Icons.Default.PlayArrow,\n                                    contentDescription \u003d \"Play/Pause\",\n                                    tint \u003d VoidBlack,\n                                    modifier \u003d Modifier.size(30.dp)\n                                )\n                            }\n                        }\n\n                        Spacer(modifier \u003d Modifier.width(16.dp))\n\n                        IconButton(\n                            onClick \u003d {\n                                val target \u003d (exoPlayer.currentPosition + 10_000L).coerceAtMost(totalDurationMs)\n                                exoPlayer.seekTo(target)\n                            }\n                        ) {\n                            Icon(\n                                imageVector \u003d Icons.Default.FastForward,\n                                contentDescription \u003d \"Fast Forward 10s\",\n                                tint \u003d TextSecondary\n                            )\n                        }\n                    }\n\n                    // Variable Speed Selector (0.5x to 2.0x)\n                    Spacer(modifier \u003d Modifier.height(4.dp))\n                    Text(\n                        text \u003d \"Playback Speed (${playbackSpeed}x)\",\n                        color \u003d TextSecondary,\n                        fontSize \u003d 11.sp,\n                        fontFamily \u003d FontFamily.Monospace\n                    )\n                    val speedOptions \u003d listOf(0.5f, 0.75f, 1.0f, 1.25f, 1.5f, 2.0f)\n                    CyberChipSelector(\n                        items \u003d speedOptions,\n                        selectedItem \u003d playbackSpeed,\n                        onItemSelected \u003d { speed -\u003e\n                            playbackSpeed \u003d speed\n                            exoPlayer.playbackParameters \u003d PlaybackParameters(speed)\n                        },\n                        labelProvider \u003d { \"${it}x\" }\n                    )\n                }\n            }\n\n            // Lossless Video Trimming Engine Card\n            CyberCard(\n                borderColor \u003d ElectricCyan.copy(alpha \u003d 0.4f)\n            ) {\n                Column(verticalArrangement \u003d Arrangement.spacedBy(14.dp)) {\n                    Row(\n                        modifier \u003d Modifier.fillMaxWidth(),\n                        horizontalArrangement \u003d Arrangement.SpaceBetween,\n                        verticalAlignment \u003d Alignment.CenterVertically\n                    ) {\n                        Row(verticalAlignment \u003d Alignment.CenterVertically) {\n                            Icon(\n                                imageVector \u003d Icons.Default.ContentCut,\n                                contentDescription \u003d null,\n                                tint \u003d ElectricCyan,\n                                modifier \u003d Modifier.size(16.dp)\n                            )\n                            Spacer(modifier \u003d Modifier.width(6.dp))\n                            Text(\n                                text \u003d \"LOSSLESS KEYFRAME TRIMMER\",\n                                color \u003d TextPrimary,\n                                fontSize \u003d 13.sp,\n                                fontWeight \u003d FontWeight.Bold,\n                                fontFamily \u003d FontFamily.Monospace\n                            )\n                        }\n                        CyberBadge(text \u003d \"0% Quality Loss\", accentColor \u003d AcidLime)\n                    }\n\n                    Text(\n                        text \u003d \"Native MediaExtractor + MediaMuxer chunk pipeline. Cuts video at keyframes in milliseconds without re-encoding.\",\n                        color \u003d TextSecondary,\n                        fontSize \u003d 11.sp\n                    )\n\n                    // Dual trim range slider\n                    Column(verticalArrangement \u003d Arrangement.spacedBy(4.dp)) {\n                        RangeSlider(\n                            value \u003d trimRange,\n                            onValueChange \u003d { range -\u003e\n                                trimRange \u003d range\n                                exoPlayer.seekTo(range.start.toLong())\n                            },\n                            valueRange \u003d 0f..totalDurationMs.toFloat(),\n                            colors \u003d SliderDefaults.colors(\n                                thumbColor \u003d ElectricCyan,\n                                activeTrackColor \u003d ElectricCyan,\n                                inactiveTrackColor \u003d SlateSurfaceElevated\n                            )\n                        )\n\n                        // Start / End / Duration readouts\n                        Row(\n                            modifier \u003d Modifier.fillMaxWidth(),\n                            horizontalArrangement \u003d Arrangement.SpaceBetween\n                        ) {\n                            Text(\n                                text \u003d \"START: ${formatTimeMs(trimRange.start.toLong())}\",\n                                color \u003d ElectricCyan,\n                                fontSize \u003d 11.sp,\n                                fontFamily \u003d FontFamily.Monospace,\n                                fontWeight \u003d FontWeight.Bold\n                            )\n                            Text(\n                                text \u003d \"CLIP: ${formatTimeMs((trimRange.endInclusive - trimRange.start).toLong())}\",\n                                color \u003d AcidLime,\n                                fontSize \u003d 11.sp,\n                                fontFamily \u003d FontFamily.Monospace,\n                                fontWeight \u003d FontWeight.Bold\n                            )\n                            Text(\n                                text \u003d \"END: ${formatTimeMs(trimRange.endInclusive.toLong())}\",\n                                color \u003d ElectricCyan,\n                                fontSize \u003d 11.sp,\n                                fontFamily \u003d FontFamily.Monospace,\n                                fontWeight \u003d FontWeight.Bold\n                            )\n                        }\n                    }\n\n                    // Export progress if active\n                    AnimatedVisibility(visible \u003d trimProgress !\u003d null) {\n                        Column(verticalArrangement \u003d Arrangement.spacedBy(6.dp)) {\n                            Row(\n                                modifier \u003d Modifier.fillMaxWidth(),\n                                horizontalArrangement \u003d Arrangement.SpaceBetween\n                            ) {\n                                Text(\n                                    text \u003d \"Exporting lossless cut...\",\n                                    color \u003d ElectricCyan,\n                                    fontSize \u003d 11.sp,\n                                    fontFamily \u003d FontFamily.Monospace\n                                )\n                                Text(\n                                    text \u003d \"${((trimProgress ?: 0f) * 100).toInt()}%\",\n                                    color \u003d ElectricCyan,\n                                    fontSize \u003d 11.sp,\n                                    fontFamily \u003d FontFamily.Monospace\n                                )\n                            }\n                            LinearProgressIndicator(\n                                progress \u003d { trimProgress ?: 0f },\n                                modifier \u003d Modifier\n                                    .fillMaxWidth()\n                                    .height(6.dp)\n                                    .clip(RoundedCornerShape(3.dp)),\n                                color \u003d ElectricCyan,\n                                trackColor \u003d SlateSurfaceElevated\n                            )\n                        }\n                    }\n\n                    // Lossless Export Button\n                    Button(\n                        onClick \u003d {\n                            val startMs \u003d trimRange.start.toLong()\n                            val endMs \u003d trimRange.endInclusive.toLong()\n                            viewModel.trimVideoLossless(\n                                sourceRecording \u003d recording,\n                                startMs \u003d startMs,\n                                endMs \u003d endMs\n                            ) { result -\u003e\n                                when (result) {\n                                    is LosslessTrimmer.TrimResult.Success -\u003e {\n                                        Toast.makeText(\n                                            context,\n                                            \"Export complete! Saved to Studio Archive.\",\n                                            Toast.LENGTH_LONG\n                                        ).show()\n                                        onBack()\n                                    }\n                                    is LosslessTrimmer.TrimResult.Error -\u003e {\n                                        Toast.makeText(\n                                            context,\n                                            \"Trim error: ${result.message}\",\n                                            Toast.LENGTH_LONG\n                                        ).show()\n                                    }\n                                }\n                            }\n                        },\n                        enabled \u003d trimProgress \u003d\u003d null,\n                        modifier \u003d Modifier.fillMaxWidth(),\n                        colors \u003d ButtonDefaults.buttonColors(\n                            containerColor \u003d ElectricCyan,\n                            contentColor \u003d Color.Black\n                        ),\n                        shape \u003d RoundedCornerShape(10.dp)\n                    ) {\n                        Row(verticalAlignment \u003d Alignment.CenterVertically) {\n                            Icon(\n                                imageVector \u003d Icons.Default.ContentCut,\n                                contentDescription \u003d null,\n                                modifier \u003d Modifier.size(16.dp)\n                            )\n                            Spacer(modifier \u003d Modifier.width(8.dp))\n                            Text(\n                                text \u003d \"LOSSLESS EXPORT CLIP\",\n                                fontWeight \u003d FontWeight.Black,\n                                fontFamily \u003d FontFamily.Monospace,\n                                letterSpacing \u003d 1.sp\n                            )\n                        }\n                    }\n                }\n            }\n\n            Spacer(modifier \u003d Modifier.height(40.dp))\n        }\n    }\n}\n\nprivate fun formatTimeMs(ms: Long): String {\n    val totalSeconds \u003d ms / 1000\n    val minutes \u003d totalSeconds / 60\n    val seconds \u003d totalSeconds % 60\n    val millis \u003d (ms % 1000) / 10\n    return String.format(Locale.US, \"%02d:%02d.%02d\", minutes, seconds, millis)\n}\n",
