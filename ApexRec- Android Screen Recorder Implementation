ORAGE)\n        }\n\n        val ungranted \u003d permissions.filter {\n            ContextCompat.checkSelfPermission(this, it) !\u003d PackageManager.PERMISSION_GRANTED\n        }\n\n        if (ungranted.isNotEmpty()) {\n            permissionLauncher.launch(ungranted.toTypedArray())\n        }\n    }\n}\n\n@Composable\nfun ApexRecApp(viewModel: ApexRecViewModel) {\n    var currentDestination by remember { mutableStateOf\u003cAppDestination\u003e(AppDestination.Studio) }\n\n    Scaffold(\n        modifier \u003d Modifier\n            .fillMaxSize()\n            .background(SlateBackground),\n        bottomBar \u003d {\n            if (currentDestination !is AppDestination.PlayerAndTrimmer) {\n                CyberBottomNavigationBar(\n                    currentDestination \u003d currentDestination,\n                    onNavigate \u003d { dest -\u003e currentDestination \u003d dest }\n                )\n            }\n        }\n    ) { innerPadding -\u003e\n        Box(\n            modifier \u003d Modifier\n                .fillMaxSize()\n                .padding(innerPadding)\n        ) {\n            when (val dest \u003d currentDestination) {\n                is AppDestination.Studio -\u003e {\n                    DashboardScreen(viewModel \u003d viewModel)\n                }\n                is AppDestination.Archive -\u003e {\n                    GalleryScreen(\n                        viewModel \u003d viewModel,\n                        onSelectRecording \u003d { recording -\u003e\n                            currentDestination \u003d AppDestination.PlayerAndTrimmer(recording)\n                        }\n                    )\n                }\n                is AppDestination.PlayerAndTrimmer -\u003e {\n                    VideoPlayerAndTrimmerScreen(\n                        recording \u003d dest.recording,\n                        viewModel \u003d viewModel,\n                        onBack \u003d { currentDestination \u003d AppDestination.Archive }\n                    )\n                }\n            }\n        }\n    }\n}\n\n@Composable\nfun CyberBottomNavigationBar(\n    currentDestination: AppDestination,\n    onNavigate: (AppDestination) -\u003e Unit\n) {\n    NavigationBar(\n        modifier \u003d Modifier\n            .fillMaxWidth()\n            .height(68.dp)\n            .border(1.dp, SlateBorder)\n            .background(SlateCardSurface),\n        containerColor \u003d SlateCardSurface,\n        tonalElevation \u003d 8.dp\n    ) {\n        NavigationBarItem(\n            selected \u003d currentDestination is AppDestination.Studio,\n            onClick \u003d { onNavigate(AppDestination.Studio) },\n            icon \u003d {\n                Icon(\n                    imageVector \u003d Icons.Default.Videocam,\n                    contentDescription \u003d \"Studio\",\n                    modifier \u003d Modifier.size(22.dp)\n                )\n            },\n            label \u003d {\n                Text(\n                    text \u003d \"STUDIO\",\n                    fontSize \u003d 11.sp,\n                    fontWeight \u003d FontWeight.Bold,\n                    fontFamily \u003d FontFamily.Monospace,\n                    letterSpacing \u003d 1.sp\n                )\n            },\n            colors \u003d NavigationBarItemDefaults.colors(\n                selectedIconColor \u003d ElectricCyan,\n                selectedTextColor \u003d ElectricCyan,\n                unselectedIconColor \u003d TextMuted,\n                unselectedTextColor \u003d TextMuted,\n                indicatorColor \u003d ElectricCyan.copy(alpha \u003d 0.15f)\n            )\n        )\n\n        NavigationBarItem(\n            selected \u003d currentDestination is AppDestination.Archive,\n            onClick \u003d { onNavigate(AppDestination.Archive) },\n            icon \u003d {\n                Icon(\n                    imageVector \u003d Icons.Default.Movie,\n                    contentDescription \u003d \"Archive\",\n                    modifier \u003d Modifier.size(22.dp)\n                )\n            },\n            label \u003d {\n                Text(\n                    text \u003d \"ARCHIVE\",\n                    fontSize \u003d 11.sp,\n                    fontWeight \u003d FontWeight.Bold,\n                    fontFamily \u003d FontFamily.Monospace,\n                    letterSpacing \u003d 1.sp\n                )\n            },\n            colors \u003d NavigationBarItemDefaults.colors(\n                selectedIconColor \u003d ElectricCyan,\n                selectedTextColor \u003d ElectricCyan,\n                unselectedIconColor \u003d TextMuted,\n                unselectedTextColor \u003d TextMuted,\n                indicatorColor \u003d ElectricCyan.copy(alpha \u003d 0.15f)\n            )\n        )\n    }\n}\n",
