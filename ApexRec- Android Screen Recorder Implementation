            "CodeContent": "package com.apexrec.app.ui.viewmodel\n\nimport android.app.Application\nimport android.content.Context\nimport android.content.Intent\nimport android.net.Uri\nimport android.util.Log\nimport androidx.core.content.FileProvider\nimport androidx.lifecycle.AndroidViewModel\nimport androidx.lifecycle.viewModelScope\nimport com.apexrec.app.data.ApexRecDatabase\nimport com.apexrec.app.data.RecordingEntity\nimport com.apexrec.app.processing.LosslessTrimmer\nimport com.apexrec.app.processing.ThumbnailUtils\nimport com.apexrec.app.service.AudioSourceOption\nimport com.apexrec.app.service.BitratePreset\nimport com.apexrec.app.service.FrameRatePreset\nimport com.apexrec.app.service.LiveRecordingState\nimport com.apexrec.app.service.RecordingConfig\nimport com.apexrec.app.service.ResolutionPreset\nimport com.apexrec.app.service.ScreenRecordService\nimport com.apexrec.app.service.ServiceStatus\nimport com.apexrec.app.service.ShakeSensitivity\nimport kotlinx.coroutines.Dispatchers\nimport kotlinx.coroutines.flow.MutableStateFlow\nimport kotlinx.coroutines.flow.SharingStarted\nimport kotlinx.coroutines.flow.StateFlow\nimport kotlinx.coroutines.flow.asStateFlow\nimport kotlinx.coroutines.flow.stateIn\nimport kotlinx.coroutines.launch\nimport java.io.File\nimport java.text.SimpleDateFormat\nimport java.util.Date\nimport java.util.Locale\n\nclass ApexRecViewModel(application: Application) : AndroidViewModel(application) {\n\n    private val db \u003d ApexRecDatabase.getInstance(application)\n    private val recordingDao \u003d db.recordingDao()\n\n    private val _config \u003d MutableStateFlow(RecordingConfig())\n    val config: StateFlow\u003cRecordingConfig\u003e \u003d _config.asStateFlow()\n\n    val liveState: StateFlow\u003cLiveRecordingState\u003e \u003d ScreenRecordService.recordingState\n\n    val recordings: StateFlow\u003cList\u003cRecordingEntity\u003e\u003e \u003d recordingDao.getAllRecordings()\n        .stateIn(viewModelScope, SharingStarted.WhileSubscribed(5000), emptyList())\n\n    val totalStorageBytes: StateFlow\u003cLong?\u003e \u003d recordingDao.getTotalStorageUsed()\n        .stateIn(viewModelScope, SharingStarted.WhileSubscribed(5000), 0L)\n\n    val recordingsCount: StateFlow\u003cInt\u003e \u003d recordingDao.getRecordingsCount()\n        .stateIn(viewModelScope, SharingStarted.WhileSubscribed(5000), 0)\n\n    private val _isCountingDown \u003d MutableStateFlow(false)\n    val isCountingDown: StateFlow\u003cBoolean\u003e \u003d _isCountingDown.asStateFlow()\n\n    private val _trimProgress \u003d MutableStateFlow\u003cFloat?\u003e(null)\n    val trimProgress: StateFlow\u003cFloat?\u003e \u003d _trimProgress.asStateFlow()\n\n    fun updateResolution(resolution: ResolutionPreset) {\n        _config.value \u003d _config.value.copy(resolution \u003d resolution)\n    }\n\n    fun updateFrameRate(frameRate: FrameRatePreset) {\n        _config.value \u003d _config.value.copy(frameRate \u003d frameRate)\n    }\n\n    fun updateBitrate(bitrate: BitratePreset) {\n        _config.value \u003d _config.value.copy(bitrate \u003d bitrate)\n    }\n\n    fun updateAudioSource(source: AudioSourceOption) {\n        _config.value \u003d _config.value.copy(audioSource \u003d source)\n    }\n\n    fun toggleFacecam(enabled: Boolean) {\n        _config.value \u003d _config.value.copy(facecamEnabled \u003d enabled)\n    }\n\n    fun toggleShakeToStop(enabled: Boolean) {\n        _config.value \u003d _config.value.copy(shakeToStopEnabled \u003d enabled)\n    }\n\n    fun updateShakeSensitivity(sensitivity: ShakeSensitivity) {\n        _config.value \u003d _config.value.copy(shakeSensitivity \u003d sensitivity)\n    }\n\n    fun updateCountdown(seconds: Int) {\n        _config.value \u003d _config.value.copy(countdownSeconds \u003d seconds)\n    }\n\n    fun setCountingDown(active: Boolean) {\n        _isCountingDown.value \u003d active\n    }\n\n    fun startService(resultCode: Int, resultData: Intent) {\n        val context \u003d getApplication\u003cApplication\u003e()\n        val serviceIntent \u003d Intent(context, ScreenRecordService::class.java).apply {\n            action \u003d ScreenRecordService.ACTION_START\n            putExtra(ScreenRecordService.EXTRA_RESULT_CODE, resultCode)\n            putExtra(ScreenRecordService.EXTRA_RESULT_DATA, resultData)\n            putExtra(ScreenRecordService.EXTRA_RES_INDEX, _config.value.resolution.ordinal)\n            putExtra(ScreenRecordService.EXTRA_FPS_INDEX, _config.value.frameRate.ordinal)\n            putExtra(ScreenRecordService.EXTRA_BITRATE_INDEX, _config.value.bitrate.ordinal)\n            putExtra(ScreenRecordService.EXTRA_AUDIO_INDEX, _config.value.audioSource.ordinal)\n            putExtra(ScreenRecordService.EXTRA_SHAKE_ENABLED, _config.value.shakeToStopEnabled)\n            putExtra(ScreenRecordService.EXTRA_SHAKE_SENSITIVITY, _config.value.shakeSensitivity.ordinal)\n        }\n        context.startForegroundService(serviceIntent)\n    }\n\n    fun pauseRecording() {\n        val context \u003d getApplication\u003cApplication\u003e()\n        val intent \u003d Intent(context, ScreenRecordService::class.java).apply {\n            action \u003d ScreenRecordService.ACTION_PAUSE\n        }\n        context.startService(intent)\n    }\n\n    fun resumeRecording() {\n        val context \u003d getApplication\u003cApplication\u003e()\n        val intent \u003d Intent(context, ScreenRecordService::class.java).apply {\n            action \u003d ScreenRecordService.ACTION_RESUME\n        }\n        context.startService(intent)\n    }\n\n    fun stopRecording() {\n        val context \u003d getApplication\u003cApplication\u003e()\n        val intent \u003d Intent(context, ScreenRecordService::class.java).apply {\n            action \u003d ScreenRecordService.ACTION_STOP\n        }\n        context.startService(intent)\n    }\n\n    fun deleteRecording(recording: RecordingEntity) {\n        viewModelScope.launch(Dispatchers.IO) {\n            try {\n                val file \u003d File(recording.filePath)\n                if (file.exists()) {\n                    file.delete()\n                }\n                recording.thumbnailPath?.let {\n                    val thumbFile \u003d File(it)\n                    if (thumbFile.exists()) thumbFile.delete()\n                }\n                recordingDao.deleteRecording(recording)\n            } catch (e: Exception) {\n                Log.e(TAG, \"Failed to delete recording\", e)\n            }\n        }\n    }\n\n    fun renameRecording(id: Long, newTitle: String) {\n        viewModelScope.launch(Dispatchers.IO) {\n            recordingDao.updateTitle(id, newTitle)\n        }\n    }\n\n    fun trimVideoLossless(\n        sourceRecording: RecordingEntity,\n        startMs: Long,\n        endMs: Long,\n        onComplete: (LosslessTrimmer.TrimResult) -\u003e Unit\n    ) {\n        viewModelScope.launch(Dispatchers.IO) {\n            _trimProgress.value \u003d 0.05f\n            val context \u003d getApplication\u003cApplication\u003e()\n            val timestamp \u003d SimpleDateFormat(\"yyyyMMdd_HHmmss\", Locale.US).format(Date())\n            val sourceFile \u003d File(sourceRecording.filePath)\n            val outputName \u003d \"${sourceFile.nameWithoutExtension}_trim_$timestamp.mp4\"\n            val outputFile \u003d File(sourceFile.parentFile ?: context.filesDir, outputName)\n\n            val result \u003d LosslessTrimmer.trim(\n                sourcePath \u003d sourceRecording.filePath,\n                outputPath \u003d outputFile.absolutePath,\n                startMs \u003d startMs,\n                endMs \u003d endMs,\n                onProgress \u003d { p -\u003e _trimProgress.value \u003d p }\n            )\n\n            if (result is LosslessTrimmer.TrimResult.Success) {\n                val thumb \u003d ThumbnailUtils.generateThumbnail(context, result.outputPath)\n                val newEntity \u003d RecordingEntity(\n                    title \u003d \"${sourceRecording.title} (Trimmed)\",\n                    filePath \u003d result.outputPath,\n                    resolutionName \u003d sourceRecording.resolutionName,\n                    width \u003d sourceRecording.width,\n                    height \u003d sourceRecording.height,\n                    frameRate \u003d sourceRecording.frameRate,\n                    bitrateMbps \u003d sourceRecording.bitrateMbps,\n                    fileSizeBytes \u003d result.fileSizeBytes,\n                    durationMs \u003d result.durationMs,\n                    audioSource \u003d sourceRecording.audioSource,\n                    createdAt \u003d System.currentTimeMillis(),\n                    thumbnailPath \u003d thumb\n                )\n                recordingDao.insertRecording(newEntity)\n            }\n\n            _trimProgress.value \u003d null\n            launch(Dispatchers.Main) {\n                onComplete(result)\n            }\n        }\n    }\n\n    fun shareRecording(context: Context, recording: RecordingEntity) {\n        try {\n            val file \u003d File(recording.filePath)\n            if (!file.exists()) return\n\n            val uri \u003d FileProvider.getUriForFile(\n                context,\n                \"${context.packageName}.fileprovider\",\n                file\n            )\n\n            val shareIntent \u003d Intent(Intent.ACTION_SEND).apply {\n                type \u003d \"video/mp4\"\n                putExtra(Intent.EXTRA_STREAM, uri)\n                addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)\n            }\n            context.startActivity(Intent.createChooser(shareIntent, \"Share Screen Recording\"))\n        } catch (e: Exception) {\n            Log.e(TAG, \"Failed to share video\", e)\n        }\n    }\n\n    companion object {\n        private const val TAG \u003d \"ApexRecViewModel\"\n    }\n}\n",
