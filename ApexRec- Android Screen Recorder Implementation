ll) {\n            Icon(\n                imageVector \u003d icon,\n                contentDescription \u003d null,\n                tint \u003d accentColor,\n                modifier \u003d Modifier\n                    .size(12.dp)\n                    .padding(end \u003d 4.dp)\n            )\n        }\n        Text(\n            text \u003d text,\n            color \u003d accentColor,\n            fontSize \u003d 11.sp,\n            fontWeight \u003d FontWeight.Bold,\n            fontFamily \u003d FontFamily.Monospace,\n            letterSpacing \u003d 0.5.sp\n        )\n    }\n}\n\n@Composable\nfun PulseRecordButton(\n    isRecording: Boolean,\n    isPaused: Boolean,\n    onClick: () -\u003e Unit,\n    modifier: Modifier \u003d Modifier\n) {\n    val infiniteTransition \u003d rememberInfiniteTransition(label \u003d \"pulse_rec\")\n\n    val pulseScale by infiniteTransition.animateFloat(\n        initialValue \u003d 1f,\n        targetValue \u003d if (isRecording \u0026\u0026 !isPaused) 1.25f else 1.05f,\n        animationSpec \u003d infiniteRepeatable(\n            animation \u003d tween(if (isRecording) 800 else 1800, easing \u003d FastOutSlowInEasing),\n            repeatMode \u003d RepeatMode.Reverse\n        ),\n        label \u003d \"pulse_scale\"\n    )\n\n    val pulseAlpha by infiniteTransition.animateFloat(\n        initialValue \u003d if (isRecording) 0.6f else 0.25f,\n        targetValue \u003d 0.05f,\n        animationSpec \u003d infiniteRepeatable(\n            animation \u003d tween(if (isRecording) 800 else 1800, easing \u003d FastOutSlowInEasing),\n            repeatMode \u003d RepeatMode.Reverse\n        ),\n        label \u003d \"pulse_alpha\"\n    )\n\n    val activeColor \u003d if (isRecording) CrimsonNeon else ElectricCyan\n    val ringGlowColor \u003d if (isRecording) CrimsonBright else ElectricCyan\n\n    Box(\n        modifier \u003d modifier.size(110.dp),\n        contentAlignment \u003d Alignment.Center\n    ) {\n        // Outer pulsi